<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Установка скачанного APK (автообновление). Android 8+ покажет
         системный экран подтверждения — это и есть «предложение установить». -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <!-- ВАЖНО: разрешений UPDATE_PACKAGES_WITHOUT_USER_ACTION и
         ENFORCE_UPDATE_OWNERSHIP здесь быть НЕ должно.
         UPDATE_PACKAGES_WITHOUT_USER_ACTION разрешает объявить сессию
         установки БЕЗ подтверждения (USER_ACTION_NOT_REQUIRED) — то есть
         тихую самопереустановку. Именно этот набор (установка APK + тихий
         путь без диалога) Play Protect трактует как поведение вредоносного
         ПО и на незнакомом сайдлоаде меняет вердикт с «требуется проверка»
         на «вредоносное приложение заблокировано». ENFORCE_UPDATE_OWNERSHIP
         объявляет приложение владельцем своих обновлений — это ускоряет
         установку, но система начинает трактовать её как самообновление в
         обход пользователя, и вердикт Play Protect тоже ужесточается.
         Обновление ставит ОБЫЧНЫЙ системный установщик
         (Intent.ACTION_VIEW через FileProvider, см.
         MainActivity.installWithSystemInstaller): система сама показывает
         свой экран «Установить обновление?» с проверкой, а пользователь
         подтверждает. Не возвращать ни одно из этих разрешений и не
         возвращать сессию PackageInstaller — это и ломает установку. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
    <uses-permission android:name="android.permission.USE_EXACT_ALARM"/>
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>
    <uses-permission android:name="android.permission.VIBRATE"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32"/>
    <application
        android:label="Keramika"
        android:name="${applicationName}"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round">
        <!-- Skia вместо Impeller: на бюджетных GPU (Adreno 610 у Redmi
             Note 12) Vulkan-рендерер Impeller подтормаживает и рисует
             текст (особенно курсив) с артефактами-зазорами между глифами.
             Вид и анимации НЕ меняются — только движок отрисовки. -->
        <meta-data
            android:name="io.flutter.embedding.android.EnableImpeller"
            android:value="false" />
        <!-- ВАЖНО: здесь НЕТ android:showWhenLocked / android:turnScreenOn.
             Эти флаги на самой активности действуют ВСЕГДА — приложение
             вылезало поверх экрана блокировки при любом запуске, включая
             обычное включение телефона, и человек видел его без PIN.
             Будильнику они не нужны в манифесте: MainActivity.applyAlarmWindowFlags()
             ставит их программно ТОЛЬКО когда intent пришёл с alarm_launch /
             payload=alarm: (см. onCreate/onNewIntent). Не возвращать сюда. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/LaunchTheme"
            android:screenOrientation="portrait"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- exported=true обязателен для AlarmReceiver, иначе AlarmManager не сможет
             разбудить процесс через PendingIntent на некоторых прошивках (MIUI/Samsung). -->
        <receiver android:name=".AlarmReceiver" android:exported="true" />

        <!-- Системный оверлей Ады: компактное мини-окошко чата поверх других
             приложений. Foreground service (specialUse) — плагин
             flutter_overlay_window. -->
        <service
            android:name="flutter.overlay.window.flutter_overlay_window.OverlayService"
            android:exported="false"
            android:theme="@style/OverlayTheme"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="ada_overlay_window_service" />
        </service>

        <!-- Непрерывный звонок будильника. Пускается из AlarmReceiver по
             точному будильнику AlarmManager (это разрешённое исключение для
             старта foreground-сервиса из фона). Звонит, пока не решена задача
             пробуждения, — права на full-screen intent не требует. -->
        <service
            android:name=".AlarmForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="alarm_ring_service" />
        </service>

        <!-- Сервис чтения экрана («Специальные возможности»): Ада в мини-окне
             видит текст активного окна другого приложения и умеет подсказать
             ответ собеседнику. Текст живёт только в памяти процесса.
             exported=false корректно: сервис биндит система с правом
             BIND_ACCESSIBILITY_SERVICE, наружу он недоступен. -->
        <service
            android:name=".ScreenReaderService"
            android:exported="false"
            android:label="Keramika — контекст экрана для Ады"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/screen_reader_config" />
        </service>

        <!-- BootReceiver ловит BOOT_COMPLETED/MY_PACKAGE_REPLACED — exported=true
             обязателен для receivers с <intent-filter> на Android 12+ (API 31+). -->
        <receiver android:name=".BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- Приёмники flutter_local_notifications (22.3.2). Плагин НЕ объявляет
             их в своём манифесте — это обязанность приложения (проверено:
             android/src/main/AndroidManifest.xml плагина содержит только
             uses-permission). Без них zonedSchedule регистрирует PendingIntent
             на несуществующий компонент: AlarmManager срабатывает ровно в
             срок, широковещание уходит в никуда и уведомление не появляется.
             Так работали именно напоминания привычек и дневные пуши Ады —
             будильники и проверки идут через наш .AlarmReceiver, поэтому и
             оставались единственными живыми. exported=true — по той же
             причине, что и выше: на MIUI система не будит процесс через
             receiver, наружу не экспортируемый. -->
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver"
            android:exported="true" />
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>
        <!-- Действия (кнопки) внутри уведомления. -->
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ActionBroadcastReceiver"
            android:exported="false" />

        <!-- FileProvider раздаёт скачанный APK системному установщику
             (Intent.ACTION_VIEW) — без него система не получит файл.
             exported=false + grantUriPermissions: доступ выдаётся точечно
             флагом FLAG_GRANT_READ_URI_PERMISSION. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>

# Flutter/Dart
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.flutter-cached-deps/
build/
coverage/
*.log
*.log.*
**/logs/

# Android
*.iml
.gradle/
local.properties
captures/
.externalNativeBuild/
.cxx/
*.keystore
!debug.keystore

# Подписи релиза — НИКОГДА не коммитить (пароли подписи + приватный ключ).
android/key.properties
android/app/*.jks
*.jks

# IDE
.idea/
.vscode/
*.swp
.DS_Store

# Keramika local build artifacts
build_logs/

# Служебные каталоги внешних инструментов на машине разработчика.
# К приложению отношения не имеют — в репозиторий не едут.
.freebuff/
.workbuddy-ai/
.agnes/

# Локальные worktree'ы и обучающая выборка Ады (см. tools/build_ada_dataset.py)
worktrees/
data/

# Kotlin/Gradle локальный кэш
android/.kotlin/

# Бэкапы конфигов
*.bak

# Служебные файлы Flutter CLI
.flutter_tool_state

# Keramika локальные черновики: одноразовые скрипты правок, логи прогонов,
# дампы adb и собранные APK. Лежат в корне и к коду приложения не относятся —
# в репозиторий не едут. (tools/ и lib/ с живым кодом — НЕ здесь.)
/*.apk
/*.py
/*.ps1
/*.txt
/*.dart
/*.pid
/*.jpeg
/*.jpg
tools/_*/
$null
